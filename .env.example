# Server
PORT=3000

# UPI payment details (shown on the registration form)
# UPI_VPA is the UPI ID money is paid to — it powers the "tap to pay" deep link.
UPI_VPA=
UPI_PAYEE_NAME=Unity Run 2026

# Google Sheets (see README "Google Sheets setup" section)
# GOOGLE_SERVICE_ACCOUNT_JSON must be the full service-account key JSON, minified to a
# single line and wrapped in SINGLE quotes so the \n escapes inside it survive parsing.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Registrations

# Google Drive folder where payment screenshots are uploaded.
# Create a folder in Drive, share it with the service account email as Editor,
# then paste the folder ID from its URL here.
GOOGLE_DRIVE_FOLDER_ID=
