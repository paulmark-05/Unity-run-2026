# Server
PORT=3000

# UPI payment details (shown on the registration form)
# UPI_VPA is the UPI ID money is paid to — it powers the "tap to pay" deep link.
UPI_VPA=
UPI_PAYEE_NAME=Unity Run 2026

# Bank transfer details, shown to runners who choose NEFT/IMPS/RTGS instead of UPI.
# Any left blank show as "to be confirmed" on the form.
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_NAME=
BANK_BRANCH=

# Google Sheets (see README "Google Sheets setup" section)
# GOOGLE_SERVICE_ACCOUNT_JSON must be the full service-account key JSON, minified to a
# single line and wrapped in SINGLE quotes so the \n escapes inside it survive parsing.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Registrations

# Payment screenshot uploads.
# Screenshots go to Drive via a Google Apps Script web app deployed in the
# organizer's own account (see scripts/apps-script-upload.gs) — a service
# account has no storage quota and cannot own files in a personal Drive.
GOOGLE_DRIVE_FOLDER_ID=
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_SECRET=
