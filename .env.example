# Server
PORT=3000

# Razorpay (get these from https://dashboard.razorpay.com/app/keys)
# Start with your TEST keys, switch to LIVE keys only when ready to launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Sheets (see README "Google Sheets setup" section)
# GOOGLE_SERVICE_ACCOUNT_JSON must be the full service-account key JSON, minified to a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Registrations
